<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_8sdp" />
            <solid android:color="@color/launcher_button_pressed" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/launcher_button_pressed_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_8sdp" />
            <solid android:color="@color/launcher_button_background" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/launcher_button_stroke" />
        </shape>
    </item>
</selector>
