<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_10sdp" />
            <solid android:color="@color/background_overlay" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/launcher_button_stroke" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_10sdp" />
            <solid android:color="@color/launcher_play_pressed" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/launcher_play_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_10sdp" />
            <solid android:color="@color/launcher_play_background" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/launcher_play_stroke" />
        </shape>
    </item>
</selector>
